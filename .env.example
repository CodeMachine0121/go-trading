SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
KCANDLE_QUERY_MAX_RESULTS=1000
INDICATOR_SCRIPT_TIMEOUT_SECONDS=40
INDICATOR_SCRIPT_MEMORY_LIMIT_MEGABYTES=512
INDICATOR_SCRIPT_MAX_CONCURRENT_COMPARTMENTS=6
BACKTEST_MAX_CANDLE_COUNT=50000
BACKTEST_TIME_ALLOWANCE_SECONDS=90

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=go_trading
POSTGRES_SSL_MODE=disable

# 使用者登入。AUTH_ACCESS_TOKEN_SIGNING_KEY 是簽發登入憑證用的鑰匙，**沒有預設值也不該有**：
# 有預設值就等於所有人共用同一把，那樣的憑證誰都能自己偽造一份。
# 沒設定時：POST /sessions 與 POST /sessions/renewal 回 503，GET /users/me 一律 401
# （沒有鑰匙就誰的憑證都認不得）。只有 POST /users 與 POST /sessions/revocation 照常。
# 產生一把：openssl rand -base64 48
# 這一行**不要進版本控制**——換掉鑰匙會讓已簽發的憑證全部失效，那也是唯一能強制所有人重新登入的辦法。
AUTH_ACCESS_TOKEN_SIGNING_KEY=
# 登入憑證活多久（分鐘）。它不留存、撤不掉，所以這個數字就等於「登出之後那張還通得過多久」。
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
# 續用憑證活多久（天）。每次續用都從當下重算——持續使用就不必重登，
# 連續不用超過這個天數才要。它是留存的那一份，所以撤得掉。
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30

# 帳號開通。新建立的使用者一律「待開通」：登入得進來、問得出自己是誰、續用得了、登出得掉，
# 其餘每一件需要知道你是誰的事一律擋下（403），並附上寄信申請開通的指示。
# 放行**只在系統之外**做——直接改資料庫：
#   UPDATE "Users" SET is_enabled = true WHERE email = '<你的電子郵件>';
# 系統沒有任何開通用的操作，也沒有管理員這種身分，所以誰都放行不了自己或別人。
#
# 這兩個**都有預設值**，與上面兩把鑰匙不同——它們不是鑰匙。信箱猜得到也不會有事，
# 缺了它而讓整個服務起不來才是真的壞事。
#
# 申請開通的信要寄去哪。
ACCOUNT_ACTIVATION_REQUEST_MAILBOX=james.afternoon.dev@gmail.com
# 那封信主旨的固定前綴。完整主旨是「<前綴>：<申請人的電子郵件>」，
# 電子郵件寫在主旨裡，是為了光看信件清單就分得出要放行誰——寄件人信箱認不得人，
# 用公司信箱註冊、用私人信箱寄信是很平常的事。
ACCOUNT_ACTIVATION_SUBJECT_PREFIX=go-trading 開通申請

# 登入失敗鎖定。這道門會累：連續幾次密碼錯誤就把帳號鎖起來，鎖住期間連正確的密碼
# 也進不來——留一條後門給正確密碼，這道鎖就只是裝飾。
#
# 兩個都有預設值，而且**關不掉**：設 0 或負值會退回預設。這個服務的登入端點對外
# 全開，沒有這道鎖，一台不會累的機器遲早會把某一組密碼試出來。
#
# 沒有自助解鎖（不寄信、不發驗證碼）。時間到了自己開；等不了的人由你直接改那一列
# 的 locked_until，或請他改密碼——改密碼也會解鎖。
AUTH_SIGN_IN_FAILURE_THRESHOLD=3
AUTH_SIGN_IN_LOCKOUT_DAYS=7

# 請求節流。帶著有效登入憑證的請求算在那位使用者頭上，否則算在來源位置頭上。
# 來源位置只採信信得過的轉手說的原始來源；空的就是一層都不信（本機開發直連就是這樣）。
# 正式環境（Cloudflare 通道 → Traefik）是 10.42.0.0/16 與 CF-Connecting-IP,X-Forwarded-For。
TRUSTED_PROXY_CIDRS=
CLIENT_IP_HEADERS=X-Forwarded-For,X-Real-IP
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_BURST=120
# 建立使用者、登入、續用、改密碼：一律認來源位置，每次都要做一次很慢的密碼運算。
RATE_LIMIT_CREDENTIAL_REQUESTS_PER_MINUTE=10
RATE_LIMIT_CREDENTIAL_BURST=10
LIVE_STREAM_CONNECTIONS_PER_CLIENT=20
LIVE_STREAM_CONNECTIONS_TOTAL=1000
REQUEST_BODY_LIMIT_KILOBYTES=1024
# 沒有「回覆要在幾秒內寫完」：即時跟盤會一直寫下去。
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=120

BACKGROUND_JOBS_ENABLED=true
# 觀察清單不在這裡了——它現在由系統自己保管，用 POST /watchlist 與
# DELETE /watchlist/:symbol 增減，改完最多等一輪（一分鐘）就生效，不必重開。
# 每輪取回幾根已收完的 K 線。它同時是「這個市場整天休市了」這個判斷的唯一防線：
# 一輪問了這麼多分鐘卻一根都沒拿到才算數。K 線是一分鐘一根，所以 25 根＝25 分鐘。
KCANDLE_INGESTION_ROUND_CANDLE_COUNT=25
KCANDLE_INGESTION_BACKFILL_LOOKBACK_HOURS=24
# POST /k-candles/history 一次最多往回抓幾天。一分鐘一根，四年約兩百萬根。上限只是防打錯字，不是成本上限。
KCANDLE_HISTORY_SYNC_MAX_LOOKBACK_DAYS=3650

# 加密貨幣的行情來源。
MARKET_DATA_BASE_URL=https://api.binance.com/api/v3/klines
MARKET_DATA_SYMBOL_CATALOG_URL=https://api.binance.com/api/v3/exchangeInfo
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_REQUESTS_PER_MINUTE=600

# 加密貨幣**永續合約**的行情來源。與現貨完全分開，每一項都是另一個數字：
#   - 四個位址，因為一根合約 K 線由「價量」「標記價格」「指數價格」「溢價指數」四份答案合成。
#     指數價格那一份以 pair 指名，其餘以 symbol 指名。
#   - 額度分開算，因為這兩個場所各記各的；共用一份等於各只用到一半。
#   - 回溯天數上限自己一份，因為永續合約的歷史比現貨短得多。
CONTRACT_MARKET_DATA_BASE_URL=https://fapi.binance.com/fapi/v1/klines
CONTRACT_MARKET_DATA_MARK_PRICE_URL=https://fapi.binance.com/fapi/v1/markPriceKlines
CONTRACT_MARKET_DATA_INDEX_PRICE_URL=https://fapi.binance.com/fapi/v1/indexPriceKlines
CONTRACT_MARKET_DATA_PREMIUM_INDEX_URL=https://fapi.binance.com/fapi/v1/premiumIndexKlines
CONTRACT_MARKET_DATA_SYMBOL_CATALOG_URL=https://fapi.binance.com/fapi/v1/exchangeInfo
CONTRACT_MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10
CONTRACT_MARKET_DATA_REQUESTS_PER_MINUTE=300
CONTRACT_KCANDLE_INGESTION_ROUND_CANDLE_COUNT=25
CONTRACT_KCANDLE_INGESTION_BACKFILL_LOOKBACK_HOURS=24
CONTRACT_KCANDLE_HISTORY_SYNC_MAX_LOOKBACK_DAYS=3650

# 永續合約不是 K 線的那幾種資料，各有各的一輪。間隔設 0 或負值即停用那一輪。
#
# 資金費率結算：與合約 K 線共用上面那份額度。每一輪從上一筆接著問；從沒存過的從上市第一天問起。
CONTRACT_MARKET_DATA_FUNDING_RATE_URL=https://fapi.binance.com/fapi/v1/fundingRate
CONTRACT_FUNDING_RATE_INGESTION_INTERVAL_MINUTES=60
#
# 持倉統計（持倉量、多空人數比、大戶多空持倉比）：來源**只留最近三十天**，
# 所以這一輪停用多久、中間就永遠缺多久。來源把這類統計另外計算額度（每五分鐘一千次），
# 所以它自己一份額度，不與合約 K 線共用。
CONTRACT_MARKET_DATA_STATISTICS_BASE_URL=https://fapi.binance.com/futures/data
CONTRACT_MARKET_DATA_STATISTICS_REQUESTS_PER_MINUTE=180
CONTRACT_POSITION_STATISTIC_INGESTION_INTERVAL_MINUTES=5
#
# 交易規格（價格跳動、數量步進、最小下單量、最小名目、最小那一級的維持保證金率、
# 強平手續費率、資金費率結算間隔）。結算間隔那份清單只列出有特別設定的合約，沒列出的就是八小時。
CONTRACT_MARKET_DATA_FUNDING_INFO_URL=https://fapi.binance.com/fapi/v1/fundingInfo
CONTRACT_TRADING_SPECIFICATION_REFRESH_INTERVAL_HOURS=24

# 永續合約的**帳戶金鑰**。只有完整的維持保證金分級需要它——那一份來源只肯告訴帳戶本人。
# 到幣安「API 管理」建立一把，**只勾「讀取」**：這個系統不下單、不動資金，給它交易權限
# 只會讓金鑰外洩時的後果變大。兩個都**沒有預設值，也不該有**，而且**不要進版本控制**。
#
# 沒有設定（或只設了一半）時：不抓分級、不報錯、也不跑那一輪；其餘一切照常。
# 金鑰與密鑰不會出現在任何紀錄或回應裡。
CONTRACT_ACCOUNT_API_KEY=
CONTRACT_ACCOUNT_API_SECRET=
CONTRACT_MARKET_DATA_MAINTENANCE_MARGIN_TIER_URL=https://fapi.binance.com/fapi/v1/leverageBracket
CONTRACT_MAINTENANCE_MARGIN_TIER_REFRESH_INTERVAL_HOURS=24

# 台股的行情來源。沒有 TAIWAN_STOCK_API_KEY 時，只有台股標的抓不到、加不進觀察清單，
# 加密貨幣與其餘功能照常。
TAIWAN_STOCK_API_KEY=
TAIWAN_STOCK_INTRADAY_CANDLES_URL=https://api.fugle.tw/marketdata/v1.0/stock/intraday/candles
TAIWAN_STOCK_HISTORICAL_CANDLES_URL=https://api.fugle.tw/marketdata/v1.0/stock/historical/candles
TAIWAN_STOCK_TICKER_URL=https://api.fugle.tw/marketdata/v1.0/stock/intraday/ticker
# 即時跟盤與歷史 K 線**同一家來源**，所以沒有第二個位址：即時要的就是「今天到現在
# 的分 K」，而上面那個盤中位址本來就直接給已經成形的那一分鐘。不自己折 K 線、不做
# 累計差分、不換算單位——即時更新與它旁邊那根已存的 K 線不可能不一致。
#
# 多久要一次。一次請求只問得了一檔，所以名單愈長、實際間隔愈慢（系統自己算，取這個
# 值與額度所能負擔者的較慢者），不會讓「間隔」與「額度」兩個數字互相矛盾。
TAIWAN_STOCK_LIVE_CANDLE_INTERVAL_SECONDS=5
TAIWAN_STOCK_TIME_ZONE=Asia/Taipei
TAIWAN_STOCK_SESSION_START=09:00
TAIWAN_STOCK_SESSION_END=13:30
TAIWAN_STOCK_REQUEST_TIMEOUT_SECONDS=10
TAIWAN_STOCK_REQUESTS_PER_MINUTE=55

# 行情對話助手（/chat）。沒有 ANTHROPIC_API_KEY 時只有 /chat 不能用，其餘功能照常。
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=low
ASSISTANT_RECENT_MESSAGE_LIMIT=20
ASSISTANT_QUERY_LIMIT=40
ASSISTANT_CANDLE_LIMIT=200
ASSISTANT_DAILY_USAGE_ALLOWANCE=300000
ASSISTANT_ANSWER_LENGTH_LIMIT=2000
ASSISTANT_RESPONSE_TIMEOUT_SECONDS=120

# 保存機器人金鑰用的那把鑰匙。**沒有預設值，而且不能有**——有預設值的鑰匙就是
# 每個跑這份程式的人都知道的鑰匙，而用它鎖起來的東西等於沒鎖，只是看起來像鎖了。
# 沒設定時，Telegram 投遞那一段會回「系統目前無法安全保存機器人金鑰」並拒絕儲存；
# 它刻意不會退而求其次改用不上鎖的方式存，因為那樣會一路正常運作到被偷的那一天。
#
# 產生一把：openssl rand -base64 32
#
# 換掉它，既有的每一份設定就都開不了，使用者得重新填一次整串金鑰。
SECRET_SEAL_KEY=

# Telegram 投遞。位址與等待上限都是「別人那台服務」的事實，所以是設定不是常數：
# 測試時指到替身，正式時指到本尊。
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
