SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
KCANDLE_QUERY_MAX_RESULTS=1000
INDICATOR_SCRIPT_TIMEOUT_SECONDS=40

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=go_trading
POSTGRES_SSL_MODE=disable

# 使用者登入。AUTH_ACCESS_TOKEN_SIGNING_KEY 是簽發登入憑證用的鑰匙，**沒有預設值也不該有**：
# 有預設值就等於所有人共用同一把，那樣的憑證誰都能自己偽造一份。
# 沒設定時：POST /sessions 與 POST /sessions/renewal 回 503，GET /users/me 一律 401
# （沒有鑰匙就誰的憑證都認不得）。只有 POST /users 與 POST /sessions/revocation 照常。
# 產生一把：openssl rand -base64 48
# 這一行**不要進版本控制**——換掉鑰匙會讓已簽發的憑證全部失效，那也是唯一能強制所有人重新登入的辦法。
AUTH_ACCESS_TOKEN_SIGNING_KEY=
# 登入憑證活多久（分鐘）。它不留存、撤不掉，所以這個數字就等於「登出之後那張還通得過多久」。
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
# 續用憑證活多久（天）。每次續用都從當下重算——持續使用就不必重登，
# 連續不用超過這個天數才要。它是留存的那一份，所以撤得掉。
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30

BACKGROUND_JOBS_ENABLED=true
# 觀察清單不在這裡了——它現在由系統自己保管，用 POST /watchlist 與
# DELETE /watchlist/:symbol 增減，改完最多等一輪（一分鐘）就生效，不必重開。
KCANDLE_INGESTION_ROUND_CANDLE_COUNT=5
KCANDLE_INGESTION_BACKFILL_LOOKBACK_HOURS=24

# 加密貨幣的行情來源。
MARKET_DATA_BASE_URL=https://api.binance.com/api/v3/klines
MARKET_DATA_SYMBOL_CATALOG_URL=https://api.binance.com/api/v3/exchangeInfo
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10

# 台股的行情來源。沒有 TAIWAN_STOCK_API_KEY 時，只有台股標的抓不到、加不進觀察清單，
# 加密貨幣與其餘功能照常。免費方案同時只跟得動五檔——那正是
# TAIWAN_STOCK_SIMULTANEOUS_FOLLOW_CEILING 的意思，換方案就改這個數字。
TAIWAN_STOCK_API_KEY=
TAIWAN_STOCK_INTRADAY_CANDLES_URL=https://api.fugle.tw/marketdata/v1.0/stock/intraday/candles
TAIWAN_STOCK_HISTORICAL_CANDLES_URL=https://api.fugle.tw/marketdata/v1.0/stock/historical/candles
TAIWAN_STOCK_TICKER_URL=https://api.fugle.tw/marketdata/v1.0/stock/intraday/ticker
TAIWAN_STOCK_STREAM_URL=wss://api.fugle.tw/marketdata/v1.0/stock/streaming
# 交易時段說在市場自己的時區裡。「九點開盤」是一件關於台北的事。
TAIWAN_STOCK_TIME_ZONE=Asia/Taipei
TAIWAN_STOCK_SESSION_START=09:00
TAIWAN_STOCK_SESSION_END=13:30
TAIWAN_STOCK_SIMULTANEOUS_FOLLOW_CEILING=5
TAIWAN_STOCK_REQUEST_TIMEOUT_SECONDS=10

# 行情對話助手（/chat）。沒有 ANTHROPIC_API_KEY 時只有 /chat 不能用，其餘功能照常。
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=low
ASSISTANT_RECENT_MESSAGE_LIMIT=20
ASSISTANT_QUERY_LIMIT=8
ASSISTANT_CANDLE_LIMIT=200
ASSISTANT_DAILY_USAGE_ALLOWANCE=300000
ASSISTANT_ANSWER_LENGTH_LIMIT=2000
ASSISTANT_RESPONSE_TIMEOUT_SECONDS=120
