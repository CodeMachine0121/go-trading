SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
KCANDLE_QUERY_MAX_RESULTS=1000
INDICATOR_SCRIPT_TIMEOUT_SECONDS=40

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=go_trading
POSTGRES_SSL_MODE=disable

# 使用者登入。AUTH_ACCESS_TOKEN_SIGNING_KEY 是簽發登入憑證用的鑰匙，**沒有預設值也不該有**：
# 有預設值就等於所有人共用同一把，那樣的憑證誰都能自己偽造一份。
# 沒設定時只有 POST /sessions 不能用（回 503），建立使用者與其餘功能照常。
# 產生一把：openssl rand -base64 48
# 這一行**不要進版本控制**——換掉鑰匙會讓已簽發的憑證全部失效，那也是唯一能強制所有人重新登入的辦法。
AUTH_ACCESS_TOKEN_SIGNING_KEY=
# 登入憑證活多久（分鐘）。它不留存、撤不掉，所以這個數字就等於「登出之後那張還通得過多久」。
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
# 續用憑證活多久（天）。每次續用都從當下重算——持續使用就不必重登，
# 連續不用超過這個天數才要。它是留存的那一份，所以撤得掉。
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30

BACKGROUND_JOBS_ENABLED=true
KCANDLE_INGESTION_SYMBOLS=BTCUSDT,ETHUSDT
KCANDLE_INGESTION_ROUND_CANDLE_COUNT=5
KCANDLE_INGESTION_BACKFILL_LOOKBACK_HOURS=24
MARKET_DATA_BASE_URL=https://api.binance.com/api/v3/klines
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10

# 行情對話助手（/chat）。沒有 ANTHROPIC_API_KEY 時只有 /chat 不能用，其餘功能照常。
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=low
ASSISTANT_RECENT_MESSAGE_LIMIT=20
ASSISTANT_QUERY_LIMIT=8
ASSISTANT_CANDLE_LIMIT=200
ASSISTANT_DAILY_USAGE_ALLOWANCE=300000
ASSISTANT_ANSWER_LENGTH_LIMIT=2000
ASSISTANT_RESPONSE_TIMEOUT_SECONDS=120
